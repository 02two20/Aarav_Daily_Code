//Q)A college generates usernames from student names. Write a Java program that accepts the student&#39;s first
name, middle name, last name, and year of admission and generates a username consisting of the first
character of the first name, first character of the middle name, complete last name, and last two digits of the
admission year.//

CODE:
import java.util.*;
public class nameshort{
    String fname;
    String mname;
    String lname;
    String year;

    public nameshort(String fname,String mname,String lname, String year) {
        this.fname=fname;
        this.mname=mname;
        this.lname=lname;
        this.year=year;
    }
    
    public String nameshortening(){
        String shortened;
        String sfname;
        String smname;
        String slname;
        String syear;
        sfname=fname.substring(0,1);
        smname=mname.substring(0,1);
        slname=lname.toLowerCase();
        syear=year.substring(2);
        shortened=sfname+smname+slname+syear;
        return shortened;
    }
    public static void main(String[] args) {
        Scanner s= new Scanner(System.in);
        String first_name;
        String middle_name;
        String last_name;
        String yearr;
        System.out.println("Input first name");
        first_name=s.nextLine();
        System.out.println("Input middle name");
        middle_name=s.nextLine();
        System.out.println("Input last name");
        last_name=s.nextLine();
        System.out.println("batch year");
        yearr=s.nextLine();
        nameshort s1=new nameshort(first_name.toLowerCase(), middle_name.toLowerCase(), last_name, yearr);
        String result = s1.nameshortening();
        System.out.println("Shortened ID: " + result);
        
        s.close();



    }
}

