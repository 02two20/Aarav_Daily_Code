//Q)2.2. A bank sends transaction messages in the following format:
Write a Java program that accepts such a transaction message and extracts the transaction type, amount,
status, and reference number. The program should then display an appropriate message.//

CODE:
import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner s=new Scanner(System.in);
        System.out.println("Enter transaction message:");
        String m=s.nextLine();
        String[] a=m.split("\\|");
        String t="",amt="",st="",ref="";
        for(String x:a){
            x=x.trim();
            if(x.startsWith("TXN:"))
                t=x.substring(4).trim();
            else if(x.startsWith("AMT:"))
                amt=x.substring(4).trim();
            else if(x.startsWith("STATUS:"))
                st=x.substring(7).trim();
            else if(x.startsWith("REF:"))
                ref=x.substring(4).trim();
        }
        System.out.println("\nTransaction Type : "+t);
        System.out.println("Amount           : Rs. "+amt);
        System.out.println("Status           : "+st);
        System.out.println("Reference No.    : "+ref);
        if(st.equalsIgnoreCase("SUCCESS"))
            System.out.println("\nTransaction completed successfully.");
        else
            System.out.println("\nTransaction failed or is pending.");
        s.close();
    }
}
